{
  "name": "goryashie-tury-bot",
  "main": "worker.js",
  "compatibility_date": "2026-11-07",
  // хранилище туров
  // канал: подборка дня в 10:00, новости в 14:00, погода в 15:00, вечерний пост с картинкой в 20:00 по Астане
  "triggers": { "crons": ["0 5 * * *", "0 9 * * *", "0 10 * * *", "0 14 * * *", "0 19 * * *"] },
  // нейросеть Cloudflare для картинок вечернего поста (бесплатный лимит в день)
  "ai": { "binding": "AI" },
  "kv_namespaces": [{ "binding": "TOURS", "id": "7c6d5e1a412f49be8bbee52b952b48ae" }],
  "vars": {
    "CHANNEL_ID": "@goryashie_tury_astana",
    "CONTACT_URL": "https://wa.me/77752728282",
    "POSTS_PER_UPDATE": "3",
    // ссылка «Поделиться» из кабинета агентства (tvclid — номер агентства в Tourvisor)
    "TOUR_LINK": "https://tourcart.ru/#tvofferid={id}&tvclid=95519&tvcu=3&tvnl=3"
  }
}
